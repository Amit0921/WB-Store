# ==============================================================================
# WB-Store – Global Git Ignore
# Covers: Spring Boot (Backend), React/Vite (Frontend), Logs, IDEs & OS Files
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Logs & Runtime Output
# ------------------------------------------------------------------------------
logs/
*.log
*.log.*
*.gz
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 2. Node.js & Frontend Build Artifacts (wholesale-billing-ui)
# ------------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Frontend Environment Variables & Local Overrides
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# ------------------------------------------------------------------------------
# 3. Java & Maven Build Artifacts (store)
# ------------------------------------------------------------------------------
target/
build/
bin/
*.class
*.jar
*.war
*.ear
*.nar
.mvn/wrapper/maven-wrapper.jar

# ------------------------------------------------------------------------------
# 4. IDEs, Editors & Tools
# ------------------------------------------------------------------------------
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Eclipse / STS
.classpath
.project
.settings/
.factorypath
.apt_generated
.apt_generated_tests
.springBeans
.sts4-cache

# NetBeans
nbproject/private/
build/
nbbuild/
nbdist/
.nb-gradle/

# Generic Editors
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 5. Operating System Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
